# cube.obj
# Import into Blender with Y-forward, Z-up
#
# Vertices:                        Faces:
#      f-------g                          +-------+ 
#     /.      /|                         /.  5   /|  3 back
#    / .     / |                        / .     / |
#   e-------h  |                   2   +-------+ 1|
#   |  b . .|. c      z          right |  . . .|. +
#   | .     | /       | /y             | . 4   | /
#   |.      |/        |/               |.      |/
#   a-------d         +---- x          +-------+
#                                           6
#                                        bottom

g cube

# Vertices
v 0.0 0.0 0.0  # 1 a
v 0.0 1.0 0.0  # 2 b
v 1.0 1.0 0.0  # 3 c
v 1.0 0.0 0.0  # 4 d
v 0.0 0.0 1.0  # 5 e
v 0.0 1.0 1.0  # 6 f
v 1.0 1.0 1.0  # 7 g
v 1.0 0.0 1.0  # 8 h

# Normal vectors
# One for each face. Shared by all vertices in that face.
vn  1.0  0.0  0.0  # 1 cghd
vn -1.0  0.0  0.0  # 2 aefb
vn  0.0  1.0  0.0  # 3 gcbf
vn  0.0 -1.0  0.0  # 4 dhea
vn  0.0  0.0  1.0  # 5 hgfe
vn  0.0  0.0 -1.0  # 6 cdab

# Faces v/vt/vn
#   3-------2
#   | -     |
#   |   #   |  Each face = 2 triangles (ccw)
#   |     - |            = 1-2-3 + 1-3-4
#   4-------1

# Texture coordinates (one per vertex of each face)
# Face 1: cghd (x=0..1, y=0..1)
vt 0.0 1.0  # 1
vt 1.0 1.0  # 2
vt 1.0 0.0  # 3
vt 0.0 0.0  # 4

# Face 2: aefb
vt 0.0 1.0  # 5
vt 1.0 1.0  # 6
vt 1.0 0.0  # 7
vt 0.0 0.0  # 8

# Face 3: gcbf
vt 0.0 1.0  # 9
vt 1.0 1.0  #10
vt 1.0 0.0  #11
vt 0.0 0.0  #12

# Face 4: dhea
vt 0.0 1.0  #13
vt 1.0 1.0  #14
vt 1.0 0.0  #15
vt 0.0 0.0  #16

# Face 5: hgfe
vt 0.0 1.0  #17
vt 1.0 1.0  #18
vt 1.0 0.0  #19
vt 0.0 0.0  #20

# Face 6: cdab
vt 0.0 1.0  #21
vt 1.0 1.0  #22
vt 1.0 0.0  #23
vt 0.0 0.0  #24


# Faces v/vt/vn
# Face 1: cghd = cgh + chd
f 3/1/1 7/2/1 8/3/1
f 3/1/1 8/3/1 4/4/1

# Face 2: aefb = aef + afb
f 1/5/2 5/6/2 6/7/2
f 1/5/2 6/7/2 2/8/2

# Face 3: gcbf = gcb + gbf
f 7/9/3 3/10/3 2/11/3
f 7/9/3 2/11/3 6/12/3

# Face 4: dhea = dhe + dea
f 4/13/4 8/14/4 5/15/4
f 4/13/4 5/15/4 1/16/4

# Face 5: hgfe = hgf + hfe
f 8/17/5 7/18/5 6/19/5
f 8/17/5 6/19/5 5/20/5

# Face 6: cdab = cda + cab
f 3/21/6 4/22/6 1/23/6
f 3/21/6 1/23/6 2/24/6